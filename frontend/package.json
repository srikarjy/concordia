{
  "name": "concordia-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:stability": "tsc -b && vite build --config vite.stability.config.ts",
    "check": "tsc -b",
    "preview": "vite preview",
    "preview:stability": "vite preview --outDir dist-stability",
    "test": "playwright test",
    "test:local": "playwright test --config playwright.local.config.ts",
    "test:public": "playwright test --config playwright.public.config.ts",
    "test:all": "npm test && npm run test:local && npm run test:public"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "3dmol": "^2.5.5",
    "graphology": "^0.26.0",
    "lucide-react": "^0.468.0",
    "molstar": "5.12.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sigma": "^3.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "sass-embedded": "^1.105.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.3"
  }
}
