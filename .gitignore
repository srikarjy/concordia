.env
.env.*
!.env.example
credentials/
secrets/
*.pem
*.key

# Local bulk artifacts; commit manifests and checksums outside these paths
artifacts/
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep
!data/processed/README.md
data/evidence/payloads/
experiments/outputs/
mlruns/
wandb/

# Prompts, configs, manifests, evidence metadata, and reports stay trackable
